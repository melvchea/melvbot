[Unit]
Description=Daily Melvbot maintenance (apt, docker cleanup)
After=network-online.target
ConditionACPower=true
OnFailure=melvbot-maint-alert.service

[Service]
Type=oneshot
Environment=DOCKER_CONFIG=/home/melvbot/.docker
ExecStartPre=/usr/bin/rm -f /home/melvbot/melvbot-workspace/melvbot-data/config/state/maint-alert-sent
ExecStartPre=-/usr/lib/apt/apt-helper wait-online
ExecStart=/home/melvbot/melvbot-storage/container/scripts/daily-maint-melvbot.sh
TimeoutStopSec=3600

[Install]
WantedBy=multi-user.target
