#!/usr/bin/env bash
# Explore the repo with MiniMax instead of a Haiku subagent: the model picks regexes, grep runs on the host,
# the hits go through digest. One retry with new patterns if the first pass finds nothing.
#   dexplore "where is the DCA header rendered?" [path]    --raw prints the grep hits without the answer pass
case ${1:-} in -h|--help|'') echo 'usage: dexplore [--raw] "<question>" [path]'; exit 0 ;; esac
export DIGEST_CALLER=${DIGEST_CALLER:-dexplore}
raw=
[[ $1 == --raw ]] && { raw=1; shift; }
q=$1 dir=${2:-.}
cd "$HOME/melvbot-storage" || exit 1
files=$(git ls-files -- "$dir" | grep -vE '(package-lock\.json|\.(png|jpg|svg|lock))$')

down=$(mktemp -u)
trap 'rc=$?; rm -f "$down" "$down.err"; printf "%s\tdexplore:exit\t0\t0\texit\t%s\t0\t0\t0\n" "$(date -Iseconds)" "$rc" >>~/.local/state/melvbot/helper-usage.tsv' EXIT
check() { [[ -e $down ]] && { echo "dexplore: digest failed ($(head -n1 "$down.err" 2>/dev/null)); use Explore" >&2; exit 3; }; }
dg() { # strict digest: flag an outage instead of passing a raw tail on as an answer
  DIGEST_RAW= DIGEST_STRICT=1 digest "$@" 2>"$down.err"
  [[ $? -eq 3 ]] && { : >"$down"; return 1; }
  return 0
}
plan() { # $1 = extra hint; prints up to 6 valid EREs
  printf '%s\n' "$files" | head -n 400 | dg "Repo file list above. Question: $q. $1
Output ONLY 3-6 grep -E (POSIX ERE) patterns likely to match the relevant code, one per line, no prose, no backticks, no numbering." --words 60 |
    sed -E 's/^[-*0-9.) ]+//; s/^`+|`+$//g' | grep -v '^\s*$' | while IFS= read -r p; do
      grep -qE -- "$p" /dev/null 2>/dev/null; [[ $? -le 1 ]] && printf '%s\n' "$p"
    done | head -n 6
}
search() { # stdin = patterns; hits for the most-matched files first, capped at 40 KB
  local args=() p
  while IFS= read -r p; do args+=(-e "$p"); done
  [[ ${#args[@]} -gt 0 ]] || return 0
  printf '%s\n' "$files" | xargs -d '\n' grep -cE "${args[@]}" -- 2>/dev/null | grep -v ':0$' |
    sort -t: -k2 -nr | head -n 15 | cut -d: -f1 |
    xargs -r -d '\n' grep -nE -C2 "${args[@]}" -- 2>/dev/null | head -c 40000
}

pats=$(plan ""); check
hits=$(printf '%s\n' "$pats" | search)
if [[ -n $raw ]]; then printf 'patterns:\n%s\n\n%s\n' "$pats" "$hits"; exit 0; fi
ask="$q (answer from the grep hits; cite file:line; if they do not answer it, reply exactly NOT_FOUND)"
ans=$([[ -n $hits ]] && printf '%s\n' "$hits" | dg "$ask"); check
if [[ -z $hits || $ans == *NOT_FOUND* ]]; then
  pats2=$(plan "These patterns did not find it, use different ones: $(tr '\n' ' ' <<<"$pats")"); check
  hits=$(printf '%s\n' "$pats2" | search)
  [[ -n $hits ]] && { ans=$(printf '%s\n' "$hits" | dg "$ask"); check; }
  pats=$pats2
fi
[[ -n $ans && $ans != *NOT_FOUND* ]] && { printf '%s\n' "$ans"; exit 0; }
printf 'dexplore: not found (patterns: %s); fall back to Explore\n' "$(tr '\n' ' ' <<<"$pats")" >&2
exit 1
