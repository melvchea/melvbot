#!/usr/bin/env bash
# Typecheck melvbot (plain tsc, no model call; failures are digested).
case ${1:-} in -h|--help) echo "usage: tcheck  (tsc --noEmit: prints 'tsc: clean' on pass, digest of errors on fail; non-zero on failure)"; exit 0 ;; esac
export DIGEST_CALLER=${DIGEST_CALLER:-tcheck}
cd "$HOME/melvbot-storage/telegram-container/ts" || exit 1
tsc_out=$(npx tsc -p tsconfig.json --noEmit 2>&1)
rc=$?
if (( rc == 0 )); then
  [[ -n $tsc_out ]] && echo "$tsc_out"
  echo "tsc: clean"
else
  printf '%s\n' "$tsc_out" | digest "TypeScript errors: file:line and message, or say clean"
fi
exit $rc
