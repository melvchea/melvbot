#!/usr/bin/env bash
# Claude API lookups from the live Anthropic docs (no local API facts), via webx on MiniMax.
#   capi models|pricing|caching|tools|streaming "<question>"   one docs page, exact quotes
#   capi ask "<question>"                                      web answer limited to Anthropic docs
# Quotes the lines it relies on and gives the source URL; if the docs are unreachable it says so.
# Writing or migrating SDK code still needs /claude-api.
usage='usage: capi models|pricing|caching|tools|streaming "<q>" | capi ask "<q>"'
base=https://platform.claude.com/docs/en
guard='Answer only from the page text. Quote the exact lines used and end with the source URL. If the page lacks the answer, say so; never answer from memory.'
case ${1:-} in
  -h|--help) echo "$usage"; exit 0 ;;
  models) url=$base/about-claude/models/overview ;;
  pricing) url=$base/about-claude/pricing ;;
  caching) url=$base/build-with-claude/prompt-caching ;;
  tools) url=$base/agents-and-tools/tool-use/overview ;;
  streaming) url=$base/build-with-claude/streaming ;;
  ask) url= ;;
  *) echo "capi: unknown topic '${1:-}'" >&2; echo "$usage" >&2; exit 2 ;;
esac
[ -n "${2:-}" ] || { echo "$usage" >&2; exit 2; }
if [ -n "$url" ]; then
  exec webx extract "$url" "$2. $guard"
fi
exec webx ask "Anthropic Claude API docs (platform.claude.com, docs.anthropic.com only): $2. $guard"
