#!/usr/bin/env bash
# Deploy origin/main with ddeploy when it carries new melvbot changes, then tell Telegram only on failure or rollback (success goes to the journal). Run by a systemd user timer.
#   dautodeploy [--dry-run]
# Skips unless HEAD == origin/main, the tree is clean and HEAD is new; docs-only pushes just advance the marker.
dry=0; [[ ${1:-} == --dry-run ]] && dry=1
case ${1:-} in -h|--help) echo 'usage: dautodeploy [--dry-run]  (ddeploy origin/main when new code landed; result to Telegram)'; exit 0 ;; esac
state=$HOME/.local/state/dautodeploy
mkdir -p "$state"
exec 9>"$state/lock"; flock -n 9 || exit 0
cd "$HOME/melvbot-storage" || exit 1
systemctl is-active --quiet melvbot-daily-maint.service && exit 0 # 3am maint deploys on its own
git fetch -q origin main || exit 0
head=$(git rev-parse HEAD); short=$(git rev-parse --short HEAD)
[[ $head == "$(git rev-parse origin/main)" && -z $(git status --porcelain) ]] || exit 0
deployed=$(cat "$state/deployed" 2>/dev/null)
[[ $head == "$deployed" || $head == "$(cat "$state/failed" 2>/dev/null)" ]] && exit 0
if [[ -z $deployed ]]; then echo "$head" > "$state/deployed"; echo "dautodeploy: baseline $short"; exit 0; fi
# The nightly SDK bump in the 3am maint already tested and deployed its own commit.
if ! git log --format=%s "$deployed..$head" | grep -qv '^deps: claude-agent-sdk'; then
  (( dry )) || echo "$head" > "$state/deployed"; echo "dautodeploy: $short is the nightly SDK bump, already deployed"; exit 0
fi
changed=$(git diff --name-only "$deployed" "$head" -- telegram-container host-cli/assistant/prompts \
  ':!telegram-container/docs' ':!telegram-container/_site' ':!*.md')
if [[ -z $changed ]]; then (( dry )) || echo "$head" > "$state/deployed"; echo "dautodeploy: $short has no deployable changes"; exit 0; fi
gate=$("$HOME/melvbot-storage/host-cli/libexec/ci-gate" "$head")
if (( dry )); then echo "dautodeploy: would deploy $short (CI $gate):"; echo "$changed"; exit 0; fi
if [[ $gate != pass ]]; then echo "dautodeploy: $short waits, CI is $gate"; exit 0; fi # retried next tick; red CI ends with the next commit

notify() { docker exec melvbot melvbot notify "$1" "$short" >/dev/null 2>&1; }
log=$state/last.log
"$HOME/melvbot-storage/host-cli/bin/ddeploy" >"$log" 2>&1; rc=$?
if (( rc == 0 )); then
  echo "$head" > "$state/deployed"; echo "dautodeploy: deployed $short"
elif grep -q "rolled back" "$log"; then
  echo "$head" > "$state/failed"; notify "Deploy Rolled Back"
else
  echo "$head" > "$state/failed"; notify "Deploy Failed"
fi
exit "$rc"
