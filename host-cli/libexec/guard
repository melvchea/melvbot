#!/usr/bin/env bash
# Publish guard: fail on IPv4 addresses and emails outside the allowlists, and on
# any GUARD_TERMS match (extended regex of private names; CI secret, never in the repo).
set -u
cd "$(git rev-parse --show-toplevel)" || exit 1

ip_ok='^(127\.0\.0\.1|169\.254\.169\.254|93\.184\.215\.14)$'
mail_ok='^(noreply@anthropic\.com|[a-z]+@example\.com|k@person\.com)$'
skip=':!**/package-lock.json :!telegram-container/ts/src/assistant/net_guard.ts :!host-cli/libexec/guard'
bad=0

scan() { # label, grep -P pattern, allow regex
  local hit
  while IFS= read -r hit; do
    [[ "${hit#*:}" =~ $3 ]] && continue
    echo "guard: $1 ${hit#*:} in ${hit%%:*}"
    bad=1
  done < <(git grep -IPoH "$2" -- . $skip)
}

scan ip '(?<![\d./])(\d{1,3}\.){3}\d{1,3}(?![\d.])' "$ip_ok"
scan email '[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[a-z]{2,}' "$mail_ok"

if [ -n "${GUARD_TERMS:-}" ] && git grep -IiqE "$GUARD_TERMS" -- . $skip; then
  echo "guard: GUARD_TERMS match in:"
  git grep -IilE "$GUARD_TERMS" -- . $skip
  bad=1
fi

[ "$bad" = 0 ] && echo "guard: clean"
exit "$bad"
