{
  "name": "melvbot-daemon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "node --import tsx --test --test-timeout=30000 test/*.test.ts test/*/*.test.ts",
    "test:coverage": "node --import tsx --test --test-timeout=30000 --experimental-test-coverage --test-coverage-lines=65 --test-coverage-exclude=test/** test/*.test.ts test/*/*.test.ts",
    "doctor": "node --import tsx src/doctor.ts"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.295",
    "zod": "^4.6.5"
  }
}
