#!/bin/sh
COMPOSE_FILE="/home/melvbot/melvbot-storage/telegram-container/docker-compose.yml"
export DOCKER_CONFIG="${DOCKER_CONFIG:-/home/melvbot/.docker}"
if [ "$(id -u)" -ne 0 ]; then
  exec sudo --preserve-env=DOCKER_CONFIG "$0" "$@"
fi
docker compose -f "$COMPOSE_FILE" "$@"
_rc=$?
# Compose as root writes buildx activity/current mode 0600 into melvbot's
# DOCKER_CONFIG. The 3am bump opens those files as melvbot.
if [ -d "${DOCKER_CONFIG}/buildx" ]; then
  chown -R melvbot:melvbot "${DOCKER_CONFIG}/buildx" || true
fi
exit "$_rc"
