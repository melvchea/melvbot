#!/usr/bin/env bash
#   dsaved [days]            Claude Code token usage per day and model (transcripts), then Telegram SDK turns (turn_log); no LLM
#   dsaved --outcome [days]  Claude Code $ per day (list prices, cache writes at 5m rate) and git commits that day = $ per completed outcome; redos = fix/revert-subject commits re-touching a file changed <24h earlier
#   dsaved --sessions [days] Claude Code per session (incl. subagents): start, msgs, input / cache write / cache read / output, est $ at list prices, commits during the session (UTC start..last msg), $/commit; top 20 by $
case ${1:-} in -h|--help) echo 'usage: dsaved [--outcome|--sessions|--review] [days]  (--sessions: Claude Code per session start, msgs, tokens, est $, top 20 by $;--outcome: Claude Code $ per day at list prices / git commits that day = $ per commit;default: Claude Code CLI per day and model input / cache write / cache read / output tokens from transcripts, then Telegram SDK Claude turns, input / output tokens and no-LLM intercepts per day from turn_log)'; exit 0 ;; esac
outcome=0 sessions=0 review=0
if [[ ${1:-} == --review ]]; then review=1; shift; fi
if [[ ${1:-} == --sessions ]]; then sessions=1; shift; fi
if [[ ${1:-} == --outcome ]]; then outcome=1; shift; fi
# List prices (USD/MTok: in out cache-write-5m cache-read) from `dprices`' prices.tsv; the defaults apply until it has run.
prices=${XDG_STATE_HOME:-$HOME/.local/state}/melvbot/prices.tsv
rate() { awk -F'\t' -v m="$1" -v d="$2" '$1 == m { d = $2 " " $3 " " $4 " " $6 } END { print d }' "$prices" 2>/dev/null || echo "$2"; }
RATE_OPUS=$(rate opus "4 20 5 0.2") RATE_SONNET=$(rate sonnet "2 10 2.5 0.1") RATE_HAIKU=$(rate haiku "0.1 0.5 0.125 0.01")
export RATE_OPUS RATE_SONNET RATE_HAIKU
days=${1:-7}
since_date=
if [[ $days =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
  # YYYY-MM-DD means "since that day" (only logs after a fix).
  since_date=$days
  days=$(( ( $(date +%s) - $(date -d "$days" +%s) ) / 86400 + 1 ))
fi
[[ $days =~ ^[0-9]+$ ]] || { echo "dsaved: days must be a number or YYYY-MM-DD" >&2; exit 2; }
if [[ $review == 1 ]]; then
  echo "== \$ per commit =="; "$0" --outcome "$days"
  echo; echo "== top 5 sessions (! = review) =="; "$0" --sessions "$days" | sed -n '1,7p'
  exit 0
fi
since=${since_date:-$(date -d "$days days ago" +%F)}

# Per day and model: day, model, input, cache write, cache read, output (deduped by message id, max per field).
claude_usage() {
  local dir=~/.claude/projects/-home-melvbot-melvbot-storage
  [[ -d $dir ]] || return 0
  find "$dir" -name '*.jsonl' -print0 2>/dev/null | xargs -0 -r jq -r --arg since "$since" '
    select(.type == "assistant" and .message.usage != null and .message.id != null and (.timestamp // "") != "")
    | [.message.id, .timestamp[0:10], (.message.model // "?"),
       (.message.usage.input_tokens // 0), (.message.usage.cache_creation_input_tokens // 0),
       (.message.usage.cache_read_input_tokens // 0), (.message.usage.output_tokens // 0)] | @tsv' 2>/dev/null |
  awk -F'\t' -v since="$since" '
    $2 >= since {
      id = $1
      day[id] = $2; model[id] = $3
      for (i = 4; i <= 7; i++) if ($i + 0 > v[id, i]) v[id, i] = $i + 0
    }
    END {
      for (id in day) {
        m = model[id]; sub(/^claude-/, "", m); sub(/-[0-9]{8}$/, "", m)
        k = day[id] "\t" m
        for (i = 4; i <= 7; i++) t[k, i] += v[id, i]
        keys[k] = 1; n[k]++
      }
      for (k in keys) printf "%s\t%d\t%d\t%d\t%d\t%d\n", k, t[k, 4], t[k, 5], t[k, 6], t[k, 7], n[k]
    }' | sort
}

# Per session (subagent transcripts carry the parent sessionId): tokens and est $ at list prices, top 20 by $.
session_usage() {
  local dir=~/.claude/projects/-home-melvbot-melvbot-storage
  [[ -d $dir ]] || return 0
  echo 'Claude Code sessions (top 20 by est $; ! = over $1.5/commit or no commit, review first)'
  find "$dir" -name '*.jsonl' -print0 2>/dev/null | xargs -0 -r jq -r '
    select(.type == "assistant" and .message.usage != null and .message.id != null and (.timestamp // "") != "")
    | [.message.id, (.sessionId // "?"), .timestamp[0:16], (.message.model // "?"),
       (.message.usage.input_tokens // 0), (.message.usage.cache_creation_input_tokens // 0),
       (.message.usage.cache_read_input_tokens // 0), (.message.usage.output_tokens // 0)] | @tsv' 2>/dev/null |
  awk -F'\t' -v since="$since" '
    function h(n) { return n >= 1e6 ? sprintf("%.2fM", n / 1e6) : sprintf("%.1fk", n / 1e3) }
    substr($3, 1, 10) >= since {
      id = $1; sid[id] = $2; mdl[id] = $4
      if (!(id in ts) || $3 < ts[id]) ts[id] = $3
      for (i = 5; i <= 8; i++) if ($i + 0 > v[id, i]) v[id, i] = $i + 0
    }
    END {
      for (id in sid) {
        m = mdl[id]
        if (m ~ /opus/) { split(ENVIRON["RATE_OPUS"], q, " "); pi = q[1]; po = q[2]; pw = q[3]; pr = q[4] } else if (m ~ /sonnet/) { split(ENVIRON["RATE_SONNET"], q, " "); pi = q[1]; po = q[2]; pw = q[3]; pr = q[4] } else if (m ~ /haiku-5/) { split(ENVIRON["RATE_HAIKU"], q, " "); pi = q[1]; po = q[2]; pw = q[3]; pr = q[4] } else { pi = 1; pw = 1.25; pr = 0.1; po = 5 }
        k = sid[id]
        if (!(k in st) || ts[id] < st[k]) st[k] = ts[id]
        if (ts[id] > en[k]) en[k] = ts[id]
        n[k]++; for (i = 5; i <= 8; i++) t[k, i] += v[id, i]
        usd[k] += (v[id, 5] * pi + v[id, 6] * pw + v[id, 7] * pr + v[id, 8] * po) / 1e6
      }
      for (k in n) printf "%.2f\t%s\t%s\t%d\t%s\t%s\t%s\t%s\t%s\n", usd[k], st[k], substr(k, 1, 8), n[k], h(t[k, 5]), h(t[k, 6]), h(t[k, 7]), h(t[k, 8]), en[k]
    }' | sort -t$'\t' -k1,1 -gr | head -20 |
  awk -F'\t' -v commits="$(TZ=UTC git -C "$HOME/melvbot-storage" log --since="$since" --date=format-local:%Y-%m-%dT%H:%M --format=%ad | tr '\n' ' ')" '
    BEGIN { nc = split(commits, c, " ")
      printf "%-16s %-8s %5s %9s %9s %9s %9s %8s %7s %8s\n", "start", "session", "msgs", "input", "cache wr", "cache rd", "output", "est $", "commits", "$/commit" }
    { k = 0; for (i = 1; i <= nc; i++) if (c[i] >= $2 && c[i] <= $9) k++
      printf "%-16s %-8s %5d %9s %9s %9s %9s %8.2f %7d %8s%s\n", $2, $3, $4, $5, $6, $7, $8, $1, k, k ? sprintf("%.2f", $1 / k) : "-", (!k || $1 / k > 1.5) ? " !" : "" }'
}

# Telegram bot (Agent SDK) turns per day from turn_log; non-claude routes are intercepts (no LLM).
sdk_usage() {
  echo; echo "Telegram SDK (turn_log)"
  # claude = Telegram turns, cron = scheduled Claude turns, hit = cache read / (read + write)
  ddb conversation "SELECT substr(created_at,1,10), route, source, count(*), sum(input_tokens), sum(output_tokens), sum(cache_read_tokens), sum(cache_write_tokens) FROM turn_log WHERE created_at >= '$since' GROUP BY 1,2,3" 2>/dev/null |
  awk -F'\t' 'NR > 1 { d[$1] = 1; if ($2 == "claude" && $3 == "cron") c[$1] += $4; else if ($2 == "claude") { t[$1] += $4; i[$1] += $5; o[$1] += $6; r[$1] += $7; w[$1] += $8 } else n[$1] += $4 }
    END {
      printf "%-11s %7s %10s %9s %5s %11s %5s\n", "day", "turns", "input", "output", "hit", "intercepts", "cron"
      for (k in d) printf "%-11s %7d %9.1fk %8.1fk %4s%% %11d %5d\n", k, t[k], i[k] / 1e3, o[k] / 1e3, r[k] + w[k] ? sprintf("%.0f", 100 * r[k] / (r[k] + w[k])) : "-", n[k], c[k] | "sort"
    }'
}

cli_usage() {
  echo "Claude Code CLI (transcripts)"
  claude_usage | awk -F'\t' '
    function h(n) { return n >= 1e6 ? sprintf("%.2fM", n / 1e6) : sprintf("%.1fk", n / 1e3) }
    BEGIN { printf "%-11s %-14s %9s %9s %9s %9s\n", "day", "model", "input", "cache wr", "cache rd", "output" }
    { printf "%-11s %-14s %9s %9s %9s %9s\n", $1, $2, h($3), h($4), h($5), h($6) }'
  echo
}

if (( sessions )); then session_usage; exit 0; fi

if (( outcome )); then
  {
    git -C "$HOME/melvbot-storage" log --since="$since" --format='C%x09%as'
    # redo = fix/revert-style subject touching a file another commit touched in the previous 24h
    git -C "$HOME/melvbot-storage" log --reverse --since="$since" --format='H%x09%as%x09%ct%x09%s' --name-only |
      awk -F'\t' '
        function done() { if (hd != "" && hit) print "R\t" hd }
        $1 == "H" { done(); hd = $2; t = $3; hit = 0; fx = tolower($4) ~ /(^|[^a-z])(fix|fixes|fixed|revert|regression|again|broke|broken|restore)([^a-z]|$)/; next }
        NF { if (fx && ($0 in last) && t - last[$0] < 86400) hit = 1; last[$0] = t }
        END { done() }'
    claude_usage | awk -F'\t' '{ print "T\t" $0 }'
  } | awk -F'\t' '
    $1 == "C" { c[$2]++; d[$2] = 1; next }
    $1 == "R" { r[$2]++; next }
    {
      day = $2; m = $3; d[day] = 1
      if (m ~ /opus/) { split(ENVIRON["RATE_OPUS"], q, " "); pi = q[1]; po = q[2]; pw = q[3]; pr = q[4] }
      else if (m ~ /sonnet/) { split(ENVIRON["RATE_SONNET"], q, " "); pi = q[1]; po = q[2]; pw = q[3]; pr = q[4] }
      else if (m ~ /haiku-5/) { split(ENVIRON["RATE_HAIKU"], q, " "); pi = q[1]; po = q[2]; pw = q[3]; pr = q[4] }
      else { pi = 1; po = 5; pw = 1.25; pr = 0.1 }
      calls[day] += $8
      usd[day] +=($4 * pi + $5 * pw + $6 * pr + $7 * po) / 1e6
    }
    END {
      printf "%-11s %9s %8s %6s %9s %7s %12s\n", "day", "claude $", "commits", "redos", "$/commit", "calls", "calls/commit"
      for (k in d) {
        printf "%-11s %9.2f %8d %6d %9s %7d %12s\n", k, usd[k], c[k], r[k], c[k] ? sprintf("%.2f", usd[k] / c[k]) : "-", calls[k], c[k] ? sprintf("%.0f", calls[k] / c[k]) : "-" | "sort"
        tu += usd[k]; tc += c[k]; tr += r[k]; tn += calls[k]
      }
      close("sort")
      printf "%-11s %9.2f %8d %6d %9s %7d %12s\n", "total", tu, tc, tr, tc ? sprintf("%.2f", tu / tc) : "-", tn, tc ? sprintf("%.0f", tn / tc) : "-"
    }'
  exit 0
fi

cli_usage

sdk_usage
