#!/usr/bin/env bash
# Web search / page extraction for the host Claude Code CLI, offloaded to MiniMax, Groq fallback
# inside the melvbot container (it holds the API keys). Prints a short digest, not the page.
#   webx search "<query>" [--n 5]
#   webx extract <url> "<question>" [--words 200] [--raw]
#   webx ask "<question>" [--words 250] [--sources 3]
# Every call appends a line to ~/.local/state/melvbot/helper-usage.tsv (see dsaved).
usage='usage: webx ask "<q>" (default: one call) | extract <url> "<q>" (exact wording) | search "<query>" (links only)'
case ${1:-} in
  -h|--help) echo "$usage"; exit 0 ;;
  search|extract|ask) ;;
  *) echo "webx: unknown mode '${1:-}'" >&2; echo "$usage" >&2; exit 2 ;;
esac
out=$(mktemp) || exit 1
err=$(mktemp) || exit 1
trap 'rm -f "$out" "$err"' EXIT
start=$(date +%s%N)
status=0
timeout 180 docker exec melvbot melvbot web "$@" >"$out" 2>"$err" || status=$?
rawb=$(sed -n 's/^webx-raw-bytes: \([0-9]*\)$/\1/p' "$err" | tail -n 1)
read -r tin tout < <(sed -n 's/^helper-tokens: \([0-9]*\) \([0-9]*\)$/\1 \2/p' "$err" | tail -n 1)
grep -v '^webx-raw-bytes: \|^helper-tokens: ' "$err" >&2 || true
cat "$out"
{
  mkdir -p ~/.local/state/melvbot
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(date -Iseconds)" "webx:${1:-}" "${rawb:--}" "$(wc -c <"$out")" model "$status" "$(( ($(date +%s%N) - start) / 1000000 ))" "${tin:-0}" "${tout:-0}" >>~/.local/state/melvbot/helper-usage.tsv
} 2>/dev/null || true
exit "$status"
