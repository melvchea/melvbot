#!/usr/bin/env bash
# Condense command output with a cheap model (MiniMax, Groq fallback in the melvbot container) so the
# raw text never enters the Claude Code context. Secrets, emails and phones are masked first.
#   digest --run "some-command" "any errors? list file:line" [--words 120]   (or: some-command 2>&1 | digest "...")
# --raw (or DIGEST_RAW=1) skips the model and prints the last 60 lines. If both providers fail, the same raw tail is printed,
# unless DIGEST_STRICT=1: then nothing is printed and the exit status is 3.
# Every call appends a line to ~/.local/state/melvbot/helper-usage.tsv (see dsaved).
case ${1:-} in -h|--help) echo 'usage: <command> | digest [--raw] "<what to extract>" [--words 120]   or   digest --run "<cmd>" "<what to extract>"  (exit status of <cmd>)'; exit 0 ;; esac
raw=${DIGEST_RAW:-}
run=
args=()
while (($#)); do
  if [[ $1 == --raw ]]; then raw=1
  elif [[ $1 == --run ]]; then run=${2:-}; shift
  else args+=("$1"); fi
  shift
done
tmp=$(mktemp) || exit 1
out=$(mktemp) || exit 1
err=$(mktemp) || exit 1
trap 'rm -f "$tmp" "$out" "$err"' EXIT
start=$(date +%s%N)
caller=${DIGEST_CALLER:-direct}
# --run "<cmd>": run it here, so the whole call matches the sandbox's `digest *` exclusion (a pipe does not).
cmd_status=0
if [[ -n $run ]]; then bash -c "$run" >"$tmp" 2>&1 </dev/null; cmd_status=$?; else cat >"$tmp"; fi
mode=model
status=0
if [[ -n $run && ! -s $tmp ]]; then
  mode=passthrough
  echo "(no output, exit $cmd_status)" >"$out"
elif [[ -n $raw && $raw != 0 ]]; then
  mode=raw
  tail -n 60 "$tmp" >"$out"
elif (( $(wc -l <"$tmp") <= ${DIGEST_MIN_LINES:-30} )); then
  # Short input: a model call costs more than it saves, print as is.
  mode=passthrough
  cp "$tmp" "$out"
else
  ask=("${args[@]}")
  [[ -n $run ]] && ask[0]="${args[0]:-what to extract} (command: $run; exit $cmd_status)"
  timeout 120 docker exec -i melvbot melvbot digest "${ask[@]}" <"$tmp" >"$out" 2>"$err" || status=$?
  read -r tin tout < <(sed -n 's/^helper-tokens: \([0-9]*\) \([0-9]*\)$/\1 \2/p' "$err" | tail -n 1)
  grep -v '^helper-tokens: ' "$err" >&2 || true
  if [[ $status -ne 0 && $status -ne 2 && -n ${DIGEST_STRICT:-} && $DIGEST_STRICT != 0 ]]; then
    echo "(digest unavailable, exit $status)" >&2
    mode=strict-fail
    : >"$out"
    status=3
  elif [[ $status -ne 0 && $status -ne 2 ]]; then
    echo "(digest unavailable, exit $status; raw tail follows)" >&2
    mode=fallback
    tail -n 60 "$tmp" >"$out"
  fi
fi
cat "$out"
rc=$status
[[ $mode != model && $mode != strict-fail && $status -ne 2 ]] && rc=0
[[ -n $run ]] && rc=$cmd_status
{
  mkdir -p ~/.local/state/melvbot
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(date -Iseconds)" "${caller:-unknown}" "$(wc -c <"$tmp")" "$(wc -c <"$out")" "$mode" "$rc" "$(( ($(date +%s%N) - start) / 1000000 ))" "${tin:-0}" "${tout:-0}" >>~/.local/state/melvbot/helper-usage.tsv
} 2>/dev/null || true
exit "$rc"
