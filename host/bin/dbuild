#!/usr/bin/env bash
# docker compose build for melvbot; prints "build: ok" or the last 40 lines on failure.
# usage: dbuild [docker compose build args]  (exit status of the build)
case ${1:-} in -h|--help) echo "usage: dbuild [docker compose build args]"; exit 0 ;; esac
export COMPOSE_BAKE="${COMPOSE_BAKE:-true}"
cd "$HOME/melvbot-storage/container" || exit 1
out=$(docker compose build "$@" 2>&1); rc=$?
if (( rc == 0 )); then echo "build: ok"; else printf '%s\n' "$out" | tail -n 40; fi
exit "$rc"
