#!/usr/bin/env bash
# PreToolUse hook (Read|Bash|Agent|Edit|Write|NotebookEdit): enforce the CLAUDE.md routing order by denying calls that would
# dump big raw output into the main context or override a subagent's model to anything but haiku (coder runs Haiku 5.5 medium, Plan Opus, via their agent files).
# Code edits: the main session (or Plan) may Edit repo files directly up to MAX_EDIT lines per edit, and Write/NotebookEdit new
# files up to MAX_EDIT lines; anything bigger, a whole-file rewrite or a shell write goes to the coder subagent (Haiku). coder-lite was removed.
# Every main-session repo edit decision and every coder launch is logged to edit-route.tsv (see `dsaved --edits`).
# Escape hatch for Bash: append the comment `# raw-ok` to the command (e.g. when digest is down).
input=$(cat)
tool=$(jq -r '.tool_name' <<<"$input")

deny() {
  jq -cn --arg r "$1" '{hookSpecificOutput:{hookEventName:"PreToolUse",permissionDecision:"deny",permissionDecisionReason:$r}}'
  exit 0
}

# The main session (or the Plan subagent) edits the repo directly only for small changes (<=MAX_EDIT lines per Edit, new files <=MAX_EDIT lines); the rest goes to coder (Haiku).
# 50 since 2026-10-10: main Sonnet $10/M out vs coder Haiku $0.50/M, and a coder spec costs about as much main output as a ~50-line edit.
# Subagent tool calls carry agent_type; main-session calls don't.
REPO=/home/melvbot/melvbot-storage
MAX_EDIT=50
agent_type=$(jq -r '.agent_type // ""' <<<"$input")
cwd=$(jq -r '.cwd // ""' <<<"$input")
CODE_MSG="Over $MAX_EDIT lines, a whole-file rewrite or a shell write: write it with Edit (<=$MAX_EDIT lines per edit) or delegate to the coder subagent (Haiku) with files, goal and how to verify."
LOG=${XDG_STATE_HOME:-$HOME/.local/state}/melvbot/edit-route.tsv
route_log() { # never fails the hook
  { mkdir -p -- "$(dirname "$LOG")" && printf '%s\t%s\t%s\t%s\t%s\n' "$(date -Iseconds)" "$1" "$2" "$3" "$4" >>"$LOG"; } 2>/dev/null || true
}
in_repo() {
  local p=${1/#\~/$HOME}
  [[ $p == /* ]] || p="$cwd/$p"
  p=$(realpath -m -- "$p")
  [[ $p == "$REPO" || $p == "$REPO"/* ]]
}
if [[ -z $agent_type || $agent_type == Plan ]]; then
  case $tool in
    Edit|Write|NotebookEdit)
      fp=$(jq -r '.tool_input.file_path // .tool_input.notebook_path // ""' <<<"$input")
      if in_repo "$fp"; then
        abs=${fp/#\~/$HOME}; [[ $abs == /* ]] || abs="$cwd/$abs"; abs=$(realpath -m -- "$abs")
        rel=${abs#"$REPO"/}
        if [[ $tool == Edit ]]; then
          n=$(jq -r '(.tool_input.new_string // "") | split("\n") | length' <<<"$input")
          ok=false; (( n <= MAX_EDIT )) && ok=true
        else
          n=$(jq -r '(.tool_input.content // .tool_input.new_source // "") | split("\n") | length' <<<"$input")
          ok=false; [[ ! -e $abs ]] && (( n <= MAX_EDIT )) && ok=true
        fi
        if $ok; then route_log opus-direct "$tool" "$rel" "$n"; else route_log denied "$tool" "$rel" "$n"; deny "$CODE_MSG"; fi
      fi
      ;;
    Bash)
      cmd=$(jq -r '.tool_input.command // ""' <<<"$input")
      # A leading `cd DIR &&` changes where relative paths land.
      if [[ $cmd =~ ^[[:space:]]*cd[[:space:]]+([^[:space:];&|]+)[[:space:]]*\&\& ]]; then
        d=${BASH_REMATCH[1]}; d=${d/#\~/$HOME}
        [[ $d == /* ]] || d="$cwd/$d"
        cwd=$(realpath -m -- "$d")
      fi
      # Compute a stripped copy with heredoc bodies and quoted strings removed.
      bare=$(perl -0pe 's/<<-?\s*([\x27"]?)(\w+)\1[^\n]*\n.*?\n\s*\2(\n|$)/\n/gs; s/\x27[^\x27]*\x27//g; s/"(?:\\.|[^"\\])*"//g' <<<"$cmd")
      touches_repo=false
      { in_repo . || [[ $cmd == *"$REPO"* ]]; } && touches_repo=true
      # Redirect and tee targets inside the repo (2>&1, >&2 and /dev/* are fine).
      while read -r t; do
        [[ -z $t || $t == '&'* || $t == /dev/* ]] && continue
        in_repo "$t" && deny "$CODE_MSG"
      done < <(grep -oP '(?<![0-9&<>])>>?\s*\K[^\s;&|)]+' <<<"$bare"; grep -oP '\btee\s+(?:-a\s+)?\K[^\s;&|]+' <<<"$bare")
      # In-place editors, patches and file operations on $bare (which strips quoted/heredoc content).
      if $touches_repo && grep -qP '\b(sed|perl)\s+(-\w+\s+)*-i|\bgit apply\b|\bpatch\b|\bcp\b|\bmv\b' <<<"$bare"; then
        found_target=false
        read -ra tokens <<<"$bare"

        for tok in "${tokens[@]}"; do
          # Skip tokens starting with -
          [[ $tok == -* ]] && continue

          # Skip command names
          [[ $tok =~ ^(sed|perl|git|apply|patch|cp|mv)$ ]] && continue

          # Skip shell operators (simple check)
          [[ $tok =~ ^(\||;|&|&&|\|\||>>|>|<)$ ]] && continue

          # Process the token as a potential path
          path="$tok"

          # Strip surrounding quotes (both single and double)
          if [[ $path == \"* && $path == *\" ]]; then
            path="${path:1:-1}"
          elif [[ $path == \'* && $path == *\' ]]; then
            path="${path:1:-1}"
          fi

          # Expand leading ~
          [[ $path == \~* ]] && path="$HOME${path:1}"

          # Resolve relative paths against $cwd
          [[ $path == /* ]] || path="$cwd/$path"

          # Check if path exists or parent directory exists
          if [[ -e "$path" ]] || [[ -d "$(dirname "$path")" ]]; then
            # Check if it's in the repo
            in_repo "$path" && found_target=true && break
          fi
        done

        $found_target && deny "$CODE_MSG"
      fi
      # Inline scripts that write files (patterns must be checked on raw $cmd since they live inside heredocs/quotes).
      $touches_repo && grep -qP 'open\([^)]*["\x27][wa]\+?["\x27]|writeFile|write_text' <<<"$cmd" && deny "$CODE_MSG"
      ;;
  esac
fi

case $tool in
  Agent|Task)
    type=$(jq -r '.tool_input.subagent_type // ""' <<<"$input")
    model=$(jq -r '.tool_input.model // ""' <<<"$input")
    [[ $type == fork ]] && deny "Fork subagents always run on Opus. Use coder, Explore or general-purpose (Haiku) instead."
    [[ $type == coder-lite ]] && deny "coder-lite was removed: edit directly (<=$MAX_EDIT lines) or use coder."
    if [[ $type == coder ]]; then
      route_log coder Agent "$(jq -r '.tool_input.description // "" | gsub("[\t\n]";" ")' <<<"$input")" "$(jq -r '(.tool_input.prompt // "") | length' <<<"$input")"
    fi
    # Plan is the one Opus subagent (~/.claude/agents/Plan.md: Opus 5.5, medium effort).
    [[ $type == Plan && ( -z $model || $model == opus ) ]] && exit 0
    [[ -n $model && $model != haiku ]] && deny "Don't override subagent models. coder (Haiku 5.5 medium) and Plan (Opus) run via their agent files; everything else runs Haiku. Drop the model override or set model: haiku."
    ;;

  Read)
    path=$(jq -r '.tool_input.file_path // ""' <<<"$input")
    limit=$(jq -r '.tool_input.limit // 0' <<<"$input")
    [[ -f $path ]] || exit 0
    grep -Iq . "$path" 2>/dev/null || exit 0   # binary, image, PDF or empty: let Read handle it
    lines=$(wc -l <"$path")
    if (( lines > 200 )) && (( limit == 0 || limit > 200 )); then
      deny "$path has $lines lines. Locate with \`rg -n\`, then Read with offset/limit (<=200 lines) for the exact lines you need to edit."
    fi
    ;;

  Bash)
    cmd=$(jq -r '.tool_input.command // ""' <<<"$input")
    [[ $cmd == *'# raw-ok'* ]] && exit 0
    # Per-change verification is one call: dverify. Bare ttest (full suite) stays allowed for the final run.
    grep -qE '(^|[|;(]|&&)[[:space:]]*(tcheck\b|ttest[[:space:]]+[^-|;&[:space:]])' <<<"$cmd" &&
      deny "Use \`dverify\` (tcheck + touched tests in one call); bare \`ttest\` only for the final full run."
    # Docker helpers are sandbox-excluded only as the whole command; a pipe or chain runs them sandboxed (no docker socket).
    if grep -qE '(^|[|;&(])[[:space:]]*(ddeploy|dbuild|ttest|dverify)([[:space:]]|$)' <<<"$cmd" && grep -qE '[|;&]' <<<"$cmd"; then
      deny "Run ddeploy/dbuild/ttest/dverify bare (no pipes, &&, ;, ||): the sandbox exclusion only matches the bare command."
    fi

    # Already filtered through a digest helper or a cheap non-LLM filter.
    grep -qE '\|\s*(digest|head|tail|grep|rg|wc|jq|sort|uniq|cut|awk)\b|(^|[|;(]|&&)[[:space:]]*([A-Za-z_][A-Za-z0-9_]*=[^[:space:]]*[[:space:]]+)*(drun|dturns|ddeploy|ddb|ttest|dverify|dbuild|webx)\b' <<<"$cmd" && exit 0

    # Quoted text (commit messages, questions) is not a command.
    bare=$(perl -0pe "s/\"[^\"]*\"//gs; s/'[^']*'//gs" <<<"$cmd")
    grep -qE '\bdocker (compose )?logs\b' <<<"$bare" && ! grep -qE -- '--tail[ =]?[0-9]{1,2}\b' <<<"$bare" &&
      deny "Raw container logs. Pipe through \`digest \"<question>\"\` or use \`--tail N\` (N<100)."
    grep -qE '\bgit (diff|show|log -p)\b' <<<"$bare" && ! grep -qE -- '--(stat|shortstat|numstat|name-only|name-status|quiet|exit-code)\b|--format|--oneline' <<<"$bare" &&
      deny "Raw diff. Use \`git diff --stat\`, \`git diff -- <file> | head -n N\`, or pipe through \`digest\`."
    grep -qE '\bnode --import tsx --test\b|\bnpm (run )?test\b' <<<"$cmd" &&
      deny "Raw test output. Use \`ttest\` (failures only)."
    grep -qE '\btsc\b' <<<"$cmd" && deny "Raw typecheck output. Use \`dverify\`."
    grep -qE '\bdocker compose build\b' <<<"$cmd" && deny "Raw build output. Use \`dbuild\`."
    # `cat bigfile` with no filter.
    if [[ $cmd =~ ^[[:space:]]*cat[[:space:]]+(-n[[:space:]]+)?([^|<>\;\&[:space:]]+)[[:space:]]*$ ]]; then
      f=${BASH_REMATCH[2]}; f=${f/#\~/$HOME}
      [[ -f $f ]] && (( $(wc -l <"$f") > 200 )) &&
        deny "$f is large. Locate with \`rg -n\`, then \`sed -n 'A,Bp'\` / head / tail for exact lines."
    fi
    ;;
esac
exit 0
